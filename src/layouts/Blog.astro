---
import '../styles/blog.css';
interface Props { title?: string; }
const { title = 'zini9188' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('blog-theme') || 'light'; } catch {}
      try { document.documentElement.dataset.sidebar = localStorage.getItem('blog-sidebar') || 'expanded'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class="header shell">
      <div class="brand-group">
        <button id="sidebar-toggle" class="sidebar-toggle" type="button" aria-label="사이드바 접기" aria-controls="blog-sidebar" aria-expanded="true"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16m7-11-3 3 3 3"/></svg></button>
        <a class="brand" href="/" aria-label="글 목록">zini9188<span>.</span></a>
      </div>
      <nav aria-label="주 메뉴">
        <a href="https://github.com/zini9188" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <button id="theme" class="theme" type="button" aria-label="어두운 화면으로 전환">◐</button>
      </nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="footer shell"><span>© {new Date().getUTCFullYear()} zini9188</span></footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme');
      function updateLabel() {
        button?.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? '밝은 화면으로 전환' : '어두운 화면으로 전환');
      }
      updateLabel();
      button?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('blog-theme', theme); } catch {}
        updateLabel();
      });
      const sidebarButton = document.querySelector<HTMLButtonElement>('#sidebar-toggle');
      const sidebar = document.querySelector<HTMLElement>('#blog-sidebar');
      function syncSidebar() {
        const expanded = document.documentElement.dataset.sidebar !== 'collapsed';
        sidebarButton?.setAttribute('aria-expanded', String(expanded));
        sidebarButton?.setAttribute('aria-label', expanded ? '사이드바 접기' : '사이드바 펼치기');
        if (sidebar) sidebar.hidden = !expanded;
      }
      syncSidebar();
      sidebarButton?.addEventListener('click', () => {
        const state = document.documentElement.dataset.sidebar === 'collapsed' ? 'expanded' : 'collapsed';
        document.documentElement.dataset.sidebar = state;
        try { localStorage.setItem('blog-sidebar', state); } catch {}
        syncSidebar();
      });
    </script>
  </body>
</html>
